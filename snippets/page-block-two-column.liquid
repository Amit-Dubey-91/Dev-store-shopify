{%- doc -%}
  Renders a Two-Column layout block from a `page_block` metaobject entry.

  @param {metaobject} block - The `page_block` metaobject entry.
  @param {string} [section_id] - The parent section ID.
{%- enddoc -%}

{%- liquid
  assign heading = block.heading.value
  assign text = block.text
  assign image = block.image.value
  assign cta_label = block.cta_label.value
  assign cta_url = block.cta_url.value
  assign has_cta = false
  if cta_label != blank and cta_url != blank
    assign has_cta = true
  endif
  assign has_content = false
  if heading != blank or text != blank or has_cta
    assign has_content = true
  endif
-%}

{%- if image != blank or has_content -%}
  <div class="mpb-block mpb-two-column">
    <div class="mpb-two-column__grid{% if image == blank or has_content == false %} mpb-two-column__grid--single{% endif %}">
      {%- if image != blank -%}
        {%- assign image_alt = image.alt | default: heading | default: '' | escape -%}
        <div class="mpb-two-column__media">
          {{
            image
            | image_url: width: 1500
            | image_tag:
              widths: '360, 535, 750, 1070, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: image_alt,
              loading: 'lazy',
              class: 'mpb-two-column__image'
          }}
        </div>
      {%- endif -%}

      {%- if has_content -%}
        <div class="mpb-two-column__content">
          {%- if heading != blank -%}
            <h2 class="mpb-two-column__heading h2">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if text != blank -%}
            <div class="mpb-two-column__text rte">{{ text | metafield_tag }}</div>
          {%- endif -%}
          {%- if has_cta -%}
            <div class="mpb-two-column__actions">
              <a href="{{ cta_url }}" class="button button--primary mpb-two-column__cta">
                {{ cta_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

